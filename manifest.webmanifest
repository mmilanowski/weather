{
  "name": "Weather",
  "short_name": "Weather",
  "description": "A clean, minimal weather app.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F6F9",
